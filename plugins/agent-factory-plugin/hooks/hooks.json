{
  "hooks": {

    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|Glob|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/allow-factory-paths.mjs\" \"${CLAUDE_PLUGIN_ROOT}\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *commit*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/capture-commit-session.mjs\""
          }
        ]
      }
    ]
  }
}
